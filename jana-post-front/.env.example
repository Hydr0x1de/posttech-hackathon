# Демо-разбор без бэкенда (true) или реальный API (false).
VITE_API_MOCK=false

# База API для браузера. Vite proxy использует API_PROXY_TARGET.
VITE_API_BASE=/api/v1

# Адрес бэкенда для dev-прокси Vite.
API_PROXY_TARGET=http://localhost:8000

# Онлайн-геокодер Nominatim/Overpass как резервный вариант.
# Для офлайн-прогона держите false: точка берётся из /api/v1/geocode.
VITE_ALLOW_ONLINE_GEOCODER=false
