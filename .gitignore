# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# virtual environments
.venv/
venv/
env/
ENV/

# test / lint / type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
coverage.xml
htmlcov/

# packaging
*.egg-info/
.eggs/
build/
dist/
wheels/

# --- OS / editors -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Local runtime junk -----------------------------------------------------
*.log
logs/
tmp/
.cache/
*.tmp
*.bak
*.dump

# SQLite sidecar files (WAL/SHM/journal)
*.db-wal
*.db-shm
*.db-journal

# The production DB is 246.6 MB and is NOT stored in Git (GitHub limit 100 MB).
# Put it at backend/data/address_base.db before running docker compose.
backend/data/*.db
!backend/data/.gitkeep

# Raw geo dumps are not committed; the ready DB is delivered separately.
*.pbf
base-builder/*.db
base-builder/*.json

ТЗ_JanaAddress.md
