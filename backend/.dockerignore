# VCS / local environments
.git
.gitignore
.venv
venv
env

# Python caches and test artifacts
__pycache__
*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
.coverage.*
htmlcov

# Not needed inside the production image
tests
scripts
benchmarks
dev
*.md
!README.md

# The production DB is baked into the image. It is not stored in Git,
# so image builds (CI) download the release asset first.
data/*
!data/.gitkeep
!data/address_base.db

# Logs and temp files
*.log
tmp
